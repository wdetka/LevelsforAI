<!-- templates/transition-config.hbs -->
<div class="form-group">
  <label>Enable Transition</label>
  <div class="form-fields">
    <input type="checkbox" name="flags.{{moduleId}}.{{flags.ENABLED}}" {{checked transition.enabled}}>
  </div>
  <p class="hint">When a token enters this region, trigger a transition.</p>
</div>

<div class="form-group">
  <label>Destination Region</label>
  <div class="form-fields">
    <select name="flags.{{moduleId}}.{{flags.DESTINATION_REGION_ID}}">
      <option value="">— None —</option>
      {{#each transition.allRegions}}
        <option value="{{this.id}}" {{#if (eq this.id ../transition.destinationRegionId)}}selected{{/if}}>
          {{this.name}}
        </option>
      {{/each}}
    </select>
  </div>
  <p class="hint">The region where tokens will be teleported.</p>
</div>

<div class="form-group">
  <label>Exit Distance (grid units)</label>
  <div class="form-fields">
    <input type="number" name="flags.{{moduleId}}.{{flags.EXIT_DISTANCE}}" value="{{transition.exitDistance}}" step="1" min="0">
  </div>
  <p class="hint">How far beyond the destination region the token should appear.</p>
</div>

<div class="form-group">
  <label>Ask Confirmation</label>
  <div class="form-fields">
    <input type="checkbox" name="flags.{{moduleId}}.{{flags.CONFIRM}}" {{checked transition.confirm}}>
  </div>
  <p class="hint">If unchecked, transition happens instantly when a token enters.</p>
</div>

<div class="form-group">
  <label>Elevation</label>
  <div class="form-fields">
    <input type="number" name="flags.{{moduleId}}.{{flags.ELEVATION}}" value="{{transition.elevation}}" step="1">
  </div>
  <p class="hint">The elevation to set after transition (requires Levels module).</p>
</div>